        raise SystemExit('Granola audio/meeting/primary-window setup changed; review before updating this app version')
    source = audio.sub(lambda m: f'function {m["send"]}({m["arg"]}){{if(process.platform===`linux`)return {runtime}.handle({m["arg"]},{m["receive"]});{m["broadcast"]}(`to-audio-process`,{m["arg"]})}}function {m["receive"]}(', source)
    source = permission.sub(lambda m: f'async function {m["name"]}({m["cb"]}){{if(process.platform===`linux`)return {runtime}.microphonePermission({m["cb"]});{m["cb"]}(await {m["electron"]}.systemPreferences.askForMediaAccess(`microphone`))}}', source)
