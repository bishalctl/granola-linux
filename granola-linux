if any(text.count(anchor) != 1 for text, anchor in anchors):
    raise SystemExit('SQLite source layout changed; review the updateHook adapter')
h = h.replace('\tstatic NODE_METHOD(JS_close);', '\tstatic NODE_METHOD(JS_updateHook);\n\tstatic void UpdateHook(void*, int, const char*, const char*, sqlite3_int64);\n\tstatic NODE_METHOD(JS_close);')
h = h.replace('\tstd::set<Backup*, CompareBackup> backups;', '\tstd::set<Backup*, CompareBackup> backups;\n\tv8::Global<v8::Function> update_hook;\n\tv8::Global<v8::Context> update_context;\n\tv8::Global<v8::Value> update_exception;')
s = s.replace('\tSetPrototypeMethod(isolate, data, t, "close", JS_close);', '\tSetPrototypeMethod(isolate, data, t, "updateHook", JS_updateHook);\n\tSetPrototypeMethod(isolate, data, t, "close", JS_close);')
s = s.replace('\t\tbackups.clear();\n\t\tint status = sqlite3_close(db_handle);', '\t\tbackups.clear();\n\t\tsqlite3_update_hook(db_handle, NULL, NULL);\n\t\tupdate_hook.Reset();\n\t\tupdate_context.Reset();\n\t\tupdate_exception.Reset();\n\t\tint status = sqlite3_close(db_handle);')
s = s.replace('if (was_js_error) was_js_error = false;', '''if (was_js_error) {
        was_js_error = false;
        if (!update_exception.IsEmpty()) {
            EasyIsolate;
            auto error = update_exception.Get(isolate);
            update_exception.Reset();
            isolate->ThrowException(error);
        }
    }''')
s = s.replace('if (status != SQLITE_OK) break;', 'if (status != SQLITE_OK || db->was_js_error) break;')
s = s.replace('db->busy = false;\n\tif (status != SQLITE_OK) {', 'db->busy = false;\n\tif (status != SQLITE_OK || db->was_js_error) {')
implementation = r'''
NODE_METHOD(Database::JS_updateHook) {
    UseIsolate;
    Database* db = Unwrap<Database>(info.This());
    REQUIRE_DATABASE_OPEN(db);
    REQUIRE_DATABASE_NOT_BUSY(db);
    if (info.Length() == 0 || info[0]->IsNullOrUndefined()) {
        sqlite3_update_hook(db->db_handle, NULL, NULL);
        db->update_hook.Reset();
        db->update_context.Reset();
    } else {
        if (!info[0]->IsFunction()) { ThrowTypeError("updateHook expects a function or null"); return; }
        db->update_hook.Reset(isolate, info[0].As<v8::Function>());
        db->update_context.Reset(isolate, OnlyContext);
        sqlite3_update_hook(db->db_handle, UpdateHook, db);
    }
}

void Database::UpdateHook(void* opaque, int operation, const char* database, const char* table, sqlite3_int64 rowid) {
    Database* db = static_cast<Database*>(opaque);
    if (!db->open || db->update_hook.IsEmpty()) return;
    EasyIsolate;
    v8::HandleScope scope(isolate);
    auto context = db->update_context.Get(isolate);
    v8::Context::Scope context_scope(context);
    v8::Local<v8::Value> id;
    if (db->safe_ints) id = v8::BigInt::New(isolate, rowid);
    else id = v8::Number::New(isolate, static_cast<double>(rowid));
    v8::Local<v8::Value> args[] = {
        v8::Integer::New(isolate, operation),
        StringFromUtf8(isolate, database, -1),
        StringFromUtf8(isolate, table, -1), id
    };
    v8::TryCatch caught(isolate);
    if (db->update_hook.Get(isolate)->Call(context, v8::Undefined(isolate), 4, args).IsEmpty()) {
        db->update_exception.Reset(isolate, caught.Exception());
        db->was_js_error = true;
        sqlite3_interrupt(db->db_handle);
    }
}

'''
s = s.replace('NODE_METHOD(Database::JS_close) {', implementation + 'NODE_METHOD(Database::JS_close) {')
header.write_text(h)
source.write_text(s)
query = root.parent / 'util/query-macros.cpp'
