    primary = re.compile(r'let (?P<win>[\w$]+)=[\w$]+;(?P=win)&&(?P=win)\.on\(`close`,')
    link_args = re.compile(r'\.app\.on\(`second-instance`,async\([\w$]+,(?P<args>[\w$]+)\)=>\{if\([\w$]+\((?P=args)\)\)return;let (?P<url>[\w$]+)=(?P<parse>[\w$]+)\((?P=args)\),[\w$]+=(?P=url)&&(?P<accept>[\w$]+)\((?P=url)\)\?(?P=url):null;')
