import sys
root = Path(sys.argv[1]) / 'src/objects'
header = root / 'database.hpp'
source = root / 'database.cpp'
h, s = header.read_text(), source.read_text()
# Electron 45's V8 15.6 removes the transitional V2 APIs and requires an
# explicit external-pointer tag. Keep older Electron builds on their original
# API paths while compiling this exact public source against current headers.
macros = root.parent / 'util/macros.cpp'
entry = root.parent / 'better_sqlite3.cpp'
if 'GRANOLA_V8_COMPAT' not in macros.read_text():
    cpp = entry.read_text()
    if cpp.count('v8::External::New(isolate, addon)') != 1:
        raise SystemExit('SQLite external pointer setup changed; review V8 compatibility')
    compatibility = r'''
/* GRANOLA_V8_COMPAT */
#if V8_MAJOR_VERSION > 15 || (V8_MAJOR_VERSION == 15 && V8_MINOR_VERSION >= 6)
#undef GET_PROTOTYPE
#define GET_PROTOTYPE(obj) ((obj)->GetPrototype())
#undef PROPERTY_HOLDER
#define PROPERTY_HOLDER(info) (info).Holder()
#undef OnlyAddon
#define OnlyAddon static_cast<Addon*>(info.Data().As<v8::External>()->Value(v8::kExternalPointerTypeTagDefault))
#define GRANOLA_EXTERNAL_NEW(isolate, value) v8::External::New(isolate, value, v8::kExternalPointerTypeTagDefault)
#else
#define GRANOLA_EXTERNAL_NEW(isolate, value) v8::External::New(isolate, value)
#endif
'''
    macros.write_text(macros.read_text() + compatibility)
    entry.write_text(cpp.replace('v8::External::New(isolate, addon)', 'GRANOLA_EXTERNAL_NEW(isolate, addon)'))
# SQLite's truncate shortcut skips per-row update hooks on a full-table DELETE.
# Disable that optimization so Granola's table-change cache is invalidated for
# bulk deletes as well as inserts and targeted updates/deletes.
defines = root.parent.parent / 'deps/defines.gypi'
d = defines.read_text()
if 'SQLITE_OMIT_TRUNCATE_OPTIMIZATION' not in d:
    if d.count("'defines': [") != 1:
        raise SystemExit('SQLite build definitions changed; review change notifications')
    defines.write_text(d.replace("'defines': [", "'defines': [\n    'SQLITE_OMIT_TRUNCATE_OPTIMIZATION',"))
# Granola's renderer uses SQLite's built-in tables_used() virtual table to
# subscribe live queries to table changes. Without this build option every
# screen, including login, falls into the React error boundary.
d = defines.read_text()
if 'SQLITE_ENABLE_BYTECODE_VTAB' not in d:
    if d.count("'defines': [") != 1:
        raise SystemExit('SQLite build definitions changed; review live queries')
    defines.write_text(d.replace("'defines': [", "'defines': [\n    'SQLITE_ENABLE_BYTECODE_VTAB',"))
if 'JS_updateHook' in s:
    print('    SQLite updateHook already present')
    raise SystemExit(0)
anchors = [
    (h, '\tstatic NODE_METHOD(JS_close);'),
    (h, '\tstd::set<Backup*, CompareBackup> backups;'),
    (s, '\tSetPrototypeMethod(isolate, data, t, "close", JS_close);'),
    (s, '\t\tbackups.clear();\n\t\tint status = sqlite3_close(db_handle);'),
    (s, 'NODE_METHOD(Database::JS_close) {'),
