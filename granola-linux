query.write_text(q.replace(anchor, guard + anchor))
iterator = root / 'statement-iterator.cpp'
it = iterator.read_text()
anchor = '\tdb_state->busy = false;\n\tif (status == SQLITE_ROW) {'
if it.count(anchor) != 1:
    raise SystemExit('SQLite iterator return path changed; review callback errors')
iterator.write_text(it.replace(anchor, '\tdb_state->busy = false;\n\tif (db_state->was_js_error) status = SQLITE_ERROR;\n\tif (status == SQLITE_ROW) {'))
print('    SQLite updateHook adapter prepared')
EOF
}

