# Granola's JS wrapper calls updateHook(operation, database, table, rowid), but
# newer images ship no private C++ sources. Supply that API over SQLite's own
# update hook in the matching MIT-licensed public module. Keep encryption,
# transactions and query handling in upstream SQLite; callbacks cannot outlive
# their database and callback exceptions interrupt/propagate the SQL operation.
cmd_prepare_sqlite() {
  python3 -I - "${1:?prepare-sqlite needs an unpacked SQLite source directory}" <<'EOF'
